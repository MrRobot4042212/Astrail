# dependencies
/node_modules
# next.js
/.next/
/out/
# production
/build
# misc
.DS_Store
*.pem
# debug
npm-debug.log*
# typescript
*.tsbuildinfo
next-env.d.ts
# rust / tauri
/src-tauri/target
# Metrics binaries: large/third-party, produced or downloaded in CI (see release.yml),
# not versioned. The sidecar C# source *is* committed.
/src-tauri/binaries/*.exe
# Local secrets: IGDB credentials, updater signing key. Only the example ships.
.env
.env.*
!.env.example
*.key

# Local audit/report artifacts, kept out of the repository
meteor-audit-*.html

# Generated by tauri-build on every compile (and rewritten even when unchanged,
# which left a permanent phantom "modified" in git status).
/src-tauri/gen/schemas
