{
  "name": "astrail",
  "version": "1.3.0",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Diego Alfonso Chicoma Ibañez (Dalfon.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot4042212/Astrail.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "check": "npm run lint && npm run bindings && npx tsc --noEmit && npm run test && npm run check:legal && npm run check:rust",
    "bindings": "cd src-tauri && cargo test --lib export_bindings_",
    "check:legal": "node scripts/check-headers.mjs && node scripts/third-party-notices.mjs --check",
    "check:rust": "cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "i18next": "^26.4.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
