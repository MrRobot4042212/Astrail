<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny sidecar: streams the CPU package temperature and AMD GPU telemetry as
       key=value lines to stdout once per second, read by Rust (cputemp.rs).
       LibreHardwareMonitor loads a kernel driver to read Ryzen Tctl / Intel core
       temps, so the CPU half needs admin; the GPU half goes through the AMD
       driver's ADL and does not (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>cputemp</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Meteor</Product>
    <Authors>Diego Alfonso Chicoma Ibañez (Dalfon.dev)</Authors>
    <Copyright>Copyright (C) 2026 Diego Alfonso Chicoma Ibañez (Dalfon.dev). GPL-3.0-only.</Copyright>
  </PropertyGroup>

  <!-- Publish shape lives here, not on the CI command line, so `dotnet publish`
       from a dev machine (scripts/fetch-binaries.ps1) and from the release
       workflow produce the same single self-contained cputemp.exe. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- No native library may be bundled: a bundled one is self-extracted into
         %TEMP%\.net\cputemp\ at every start and survives uninstall. The only
         candidate, Mono.Posix's MonoPosixHelper (a transitive dependency of
         LibreHardwareMonitorLib, Linux-only code), is dropped from the publish
         below, so the published output is exactly one file. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- 72 lines of C# shipped as ~69 MB because the whole .NET runtime was
         embedded uncompressed. Compression alone roughly halves the installer;
         partial trimming drops the framework assemblies this program never
         touches. LibreHardwareMonitorLib is rooted below because it resolves
         sensor types reflectively, which the trimmer cannot see. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!-- LibreHardwareMonitor and its dependencies resolve hardware/sensor types
       reflectively (WMI, HID, generated code), which the trimmer cannot follow —
       `dotnet publish` reports IL2104 for each. Root them whole so only the
       unused *framework* is trimmed; this is what makes the result safe to ship
       without being able to exercise the kernel-driver path in CI. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="LibreHardwareMonitorLib" />
    <TrimmerRootAssembly Include="BlackSharp.Core" />
    <TrimmerRootAssembly Include="DiskInfoToolkit" />
    <TrimmerRootAssembly Include="HidSharp" />
    <TrimmerRootAssembly Include="System.CodeDom" />
    <TrimmerRootAssembly Include="System.Management" />
  </ItemGroup>

  <!-- Lock transitive NuGet versions: this process loads a kernel driver, so its
       dependency set must be reproducible and reviewable, not resolved afresh on
       every build. Locked mode makes a restore that disagrees with the lock file
       fail instead of silently rewriting it. Refresh with:
       dotnet restore /p:RestoreForceEvaluate=true /p:RestoreLockedMode=false -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <!-- PublishTrimmed adds an implicit Microsoft.NET.ILLink.Tasks reference whose
       version comes from whichever SDK runs the restore (8.0.23 from SDK 10.0.102,
       8.0.31 from SDK 8.0.425), so locked mode failed with NU1004 on any machine
       whose SDK differed from the one that wrote the lock file. Pin it here; this
       project only targets net8.0, so replacing the SDK's per-TFM list is safe. -->
  <ItemGroup>
    <KnownILLinkPack Remove="Microsoft.NET.ILLink.Tasks" />
    <KnownILLinkPack Include="Microsoft.NET.ILLink.Tasks" TargetFramework="net8.0" ILLinkPackVersion="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre704" />
  </ItemGroup>

  <!-- Drop the Mono.Posix native helper from the publish set (see
       IncludeNativeLibrariesForSelfExtract above). The single-file bundler
       refuses a native library that is neither bundled nor excluded, so this
       target is what keeps the publish at one file. -->
  <Target Name="DropMonoPosixNative" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)%(Extension)' == 'MonoPosixHelper.dll' Or '%(Filename)%(Extension)' == 'libMonoPosixHelper.dll'" />
    </ItemGroup>
  </Target>

</Project>
